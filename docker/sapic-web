#!/bin/bash
# 容器内的 web 进程：gunicorn + gevent。
# 调度器由同容器里的 sapic-scheduler 独立进程负责，这里固定 sapic_scheduler=0，
# 避免 worker 里再抢一次 data/scheduler.lock（抢不到只会多几行日志）。
set -euo pipefail

cd /app/server
export sapic_scheduler=0

exec gunicorn "sapic:create_app()" \
    --bind 127.0.0.1:9514 \
    --workers "${WEB_CONCURRENCY:-4}" \
    --worker-class gevent \
    --timeout 60 \
    --error-logfile -
